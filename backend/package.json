{
    "name": "backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"common/**/*.ts\" \"test/**/*.ts\" \"*.ts\" --no-error-on-unmatched-pattern",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "openapi:generate": "node -r ts-node/register -r tsconfig-paths/register src/openapi/generate-openapi.ts",
        "yk:preflight": "node -r ts-node/register -r tsconfig-paths/register src/database/yookassa-production-preflight.ts",
        "yk:migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/yookassa-migration.datasource.ts",
        "yk:migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/yookassa-migration.datasource.ts",
        "yk:migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/yookassa-migration.datasource.ts",
        "yk:migration:show:prod": "node ./node_modules/typeorm/cli.js migration:show -d dist/src/database/yookassa-migration.datasource.js",
        "yk:migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/src/database/yookassa-migration.datasource.js"
    },
    "dependencies": {
        "@nestjs/common": "^10.4.22",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.22",
        "@nestjs/event-emitter": "^3.0.1",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/platform-express": "^10.4.22",
        "@nestjs/schedule": "^6.0.1",
        "@nestjs/swagger": "^8.1.0",
        "@nestjs/typeorm": "^10.0.2",
        "@tma.js/init-data-node": "^2.0.8",
        "bcryptjs": "^2.4.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "cookie-parser": "^1.4.7",
        "dotenv": "^16.4.7",
        "helmet": "^8.3.0",
        "joi": "^17.13.7",
        "nestjs-paginate": "^10.0.0",
        "nestjs-telegraf": "^2.9.1",
        "pg": "^8.13.1",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "swagger-ui-express": "^5.0.1",
        "telegraf": "^4.16.3",
        "typeorm": "^0.3.31",
        "uuid": "^13.0.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/schematics": "^10.2.3",
        "@nestjs/testing": "^10.4.22",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.10.2",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.18.0",
        "@typescript-eslint/parser": "^8.18.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^2.7.1",
        "eslint-plugin-import": "^2.31.0",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.2"
    }
}
