# --- PostgreSQL ---
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DB=vpn_backend
FRONTEND_ORIGIN=http://localhost:3000
# Optional. For production with frontend/backend on sibling subdomains, set the shared parent domain,
# for example vpn.example.invalid or .vpn.example.invalid
AUTH_COOKIE_DOMAIN=
# Optional. Force Secure cookies in production behind HTTPS.
AUTH_COOKIE_SECURE=false
# Optional. Swagger is enabled outside production by default. Set true to force-enable in production.
ENABLE_SWAGGER=true
DB_SYNCHRONIZE=true

# --- JWT auth ---
JWT_REFRESH_SECRET=local-only-replace-refresh-secret
JWT_ACCESS_SECRET=local-only-replace-access-secret
JWT_ACCESS_EXPIRES=365d
JWT_REFRESH_EXPIRES=365d

# --- Telegram bot / admin ---
# Bot token from @BotFather
TELEGRAM_TOKEN=local-development-placeholder
# Launch bot polling on backend startup (true/false)
TELEGRAM_BOT_LAUNCH=false
# Bot username without @. Required for /user/telegram-link unless TELEGRAM_BOT_START_URL is set.
TELEGRAM_BOT_USERNAME=your_vpn_bot
# Optional explicit deep-link prefix, for example https://t.me/your_bot_username?start=
TELEGRAM_BOT_START_URL=
# Temporary debug: log and reply with custom_emoji_id for incoming Telegram custom emoji messages.
TELEGRAM_CUSTOM_EMOJI_DEBUG=false
# Telegram chat id for existing payment/admin-business notifications
TELEGRAM_ADMINCHAT_ID=
# Dedicated numeric Telegram group/chat id for customer-support tickets and support reply prompts.
TELEGRAM_SUPPORT_CHAT_ID=
# Dedicated numeric Telegram group/chat id for technical/application logs and errors.
TELEGRAM_LOGS_CHAT_ID=
# Private persistent directory for website support photos. Production must mount a
# writable private volume here; this directory is never served as static content.
SUPPORT_MEDIA_STORAGE_ROOT=
# Comma-separated Telegram user ids with admin role (example: 123,456)
TELEGRAM_ADMIN_IDS=
# Public legal/support info shown in /info
PRIVACY_POLICY_URL=https://vpn.example.invalid/privacy
TERMS_URL=https://vpn.example.invalid/terms
SUPPORT_CONTACT=@your_support_username

# --- Payments / Platega ---
# Telegram deep-link prefix. Backend appends local payment id.
PAYMENT_RETURN_URL=https://t.me/your_bot_username?start=pay_success_
# Optional fail deep-link prefix. If empty, PAYMENT_RETURN_URL is used.
PAYMENT_FAIL_RETURN_URL=https://t.me/your_bot_username?start=pay_fail_
# Website return URL prefix. Backend appends local payment id. Required for web payments.
PAYMENT_WEB_RETURN_URL=http://localhost:3000/payment/success/
# Optional website fail URL prefix. If empty, PAYMENT_WEB_RETURN_URL is used.
PAYMENT_WEB_FAIL_RETURN_URL=http://localhost:3000/payment/fail/
PAYMENT_PRIMARY_PROVIDER=PLATEGA
PAYMENT_YOOKASSA_ENABLED=false
PAYMENT_YOOKASSA_WEBHOOK_ENABLED=false
# Set true only after YooKassa enables saved payment methods and autopay for both SITE and BOT shops.
PAYMENT_RECURRENT_ENABLED=false
PAYMENT_ACTIVATION_RECONCILIATION_ENABLED=false
# Durable admin-chat payment notification worker. Enable only after schema sync and chat-id verification.
PAYMENT_ADMIN_NOTIFICATION_ENABLED=false
PAYMENT_YOOKASSA_STATUS_RECONCILIATION_ENABLED=false
YOOKASSA_WEBHOOK_IP_CHECK_ENABLED=false
PAYMENT_YOOKASSA_PRODUCTION_CONFIRMED=false
PAYMENT_YOOKASSA_CANARY_USER_IDS=
API_PUBLIC_ORIGIN=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_HTTP_TIMEOUT_MS=15000
YOOKASSA_SITE_SHOP_ID=
YOOKASSA_SITE_SECRET_KEY=
YOOKASSA_BOT_SHOP_ID=
YOOKASSA_BOT_SECRET_KEY=
YOOKASSA_SITE_RECEIPT_MODE=DISABLED
# YOOKASSA_SITE_VAT_CODE=1
YOOKASSA_SITE_PAYMENT_SUBJECT=
YOOKASSA_SITE_PAYMENT_MODE=
YOOKASSA_BOT_RECEIPT_MODE=DISABLED
# YOOKASSA_BOT_VAT_CODE=1
YOOKASSA_BOT_PAYMENT_SUBJECT=
YOOKASSA_BOT_PAYMENT_MODE=
PLATEGA_BASE_URL=https://payments.example.invalid/
PLATEGA_CRYPTO_ENABLED=false
PLATEGA_PAYMENT_URL_ALLOWED_HOSTS=pay.platega.io
PLATEGA_RECURRENT_ENABLED=false
# Bot payments merchant credentials
PLATEGA_MERCHANT_ID=development-placeholder
PLATEGA_SECRET=development-placeholder
# Web payments merchant credentials
PLATEGA_WEB_MERCHANT_ID=
PLATEGA_WEB_SECRET=

# --- Remnawave provider ---
REMNAWAVE_BASE_URL=https://panel.example.invalid
REMNAWAVE_API_TOKEN=change_me
REMNAWAVE_TIMEOUT_MS=10000
REMNAWAVE_DEFAULT_NODE_CODE=remnawave-default
# Optional: used to build a subscription URL when Remnawave returns shortUuid but no direct URL.
REMNAWAVE_SUBSCRIPTION_PUBLIC_BASE_URL=https://subscriptions.example.invalid
# Optional: set if your Remnawave deployment requires users to be attached to a specific squad.
REMNAWAVE_DEFAULT_SQUAD_UUID=
# Service squads preserved only for users who already have them.
# Do not include commercial tariff squads.
REMNAWAVE_PRESERVED_INTERNAL_SQUAD_UUIDS=
